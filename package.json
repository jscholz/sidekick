{
  "name": "parleyvoo",
  "version": "0.4.0",
  "type": "module",
  "description": "Parley — a voice-first portal to your agent. Bring your own backend; speaks the OpenAI Responses API.",
  "license": "MIT",
  "homepage": "https://github.com/jscholz/parley",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jscholz/parley.git"
  },
  "bin": {
    "parleyvoo": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "build/",
    "styles/",
    "assets/",
    "proxy/",
    "backends/stub/",
    "scripts/build.mjs",
    "scripts/start-all.mjs",
    "scripts/https-cert.mjs",
    "server.ts",
    "server.mjs",
    "index.html",
    "sw.js",
    "manifest.json",
    ".env.example",
    "example.parley.config.yaml",
    "docs/ABSTRACT_AGENT_PROTOCOL.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:cap": "node scripts/build.mjs && node scripts/build-cap.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "npm run build && node scripts/start-all.mjs",
    "start:proxy": "npm run build && node --experimental-strip-types --disable-warning=ExperimentalWarning server.ts",
    "start:dev": "node scripts/build.mjs --watch & node --experimental-strip-types --disable-warning=ExperimentalWarning --watch server.ts",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning 'test/**/*.test.ts' 'src/**/*.test.ts' 'proxy/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/run-smoke.mjs",
    "smoke:isolated": "node scripts/run-smoke-isolated.mjs",
    "smoke:barge": "node scripts/run-smoke-barge.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "prepack": "node scripts/build.mjs",
    "prepare": "node -e \"const fs=require('fs');if(!fs.existsSync('build/index.html')&&fs.existsSync('scripts/build.mjs')&&fs.existsSync('src'))require('child_process').execFileSync(process.execPath,['scripts/build.mjs'],{stdio:'inherit'})\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.209",
    "@capacitor/push-notifications": "^8.1.2",
    "playwright-core": "^1.59.1",
    "qrcode-terminal": "^0.12.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@ricky0123/vad-web": "^0.0.30",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@types/sortablejs": "^1.15.9",
    "esbuild": "^0.28.0",
    "js-yaml": "^4.1.1",
    "onnxruntime-web": "^1.25.1",
    "sortablejs": "^1.15.7",
    "temml": "^0.13.5",
    "typescript": "^6.0.2"
  }
}
